# Copy to .env.local and fill in from Supabase > Project Settings > API.
# The anon key is public by design; the service_role key must never be used here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Public origin of this app. Used for OAuth/email-confirmation redirects.
# Vercel will override this with the deployment domain automatically.
SITE_URL=http://localhost:3000

# DOKU Payment Gateway (Indonesian)
# Get these from: https://www.doku.co.id/dashboard
# Leave empty to disable payments; fill in .env.local to enable.
# NEVER commit real values to git — use .env.local only.
DOKU_CLIENT_KEY=your-doku-client-key
DOKU_SECRET_KEY=your-doku-secret-key
DOKU_API_KEY=your-doku-api-key
DOKU_API_URL=https://api.doku.com
DOKU_PUBLIC_KEY=your-doku-public-key
